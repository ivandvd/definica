# Copy to .env.local for local development; set the same variables in the production environment.

# Host of the deployed dApp. When set, /app on this site redirects there (e.g. https://app.definica.com).
# Leave unset to serve the dApp from this app at /app.
DAPP_URL=

# Host of the documentation site (the Docusaurus project in docs/). When set, /docs redirects there
# (e.g. https://docs.definica.com, or http://localhost:3400 while running `npm start` in docs/).
DOCS_URL=
