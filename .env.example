# Copy to .env.local for local development; set the same variables in the production environment.

# Host of the deployed dApp. When set, /app on this site redirects there (e.g. https://app.definica.com).
# Leave unset to serve the dApp from this app at /app.
DAPP_URL=

# Host of the documentation site (the Docusaurus project in docs/). When set, /docs redirects there
# (https://docs.definica.com in production, or http://localhost:3400 while running `npm start` in docs/).
DOCS_URL=

# Public addresses used in metadata, share images, robots.txt and the sitemap. Defaults: the production hosts.
NEXT_PUBLIC_SITE_URL=https://definica.com
NEXT_PUBLIC_DOCS_URL=https://docs.definica.com

# Search engines index production builds only (on Vercel, the production environment; previews stay hidden).
# Set to true to hide a production build anyway, e.g. a staging server.
NEXT_PUBLIC_NOINDEX=

# PostHog analytics. Loads only after the visitor accepts cookies, and only when a key is set.
# Project API key from PostHog (Project settings); the host is the EU cloud unless you use the US one.
# The docs read the same values at build time as POSTHOG_KEY and POSTHOG_HOST.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Where newsletter sign-ups are posted ({"email": "…"} as JSON; 2xx = subscribed, 409 = already registered).
# Leave unset until there is a sign-up service: the footer then offers Telegram and X instead of the form.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
