      "items": [
        {
          "_key": "mech01",
          "_type": "item",
          "text": [
            {
              "_key": "blkm01",
              "_type": "block",
              "children": [
                {
                  "_key": "spnm01",
                  "_type": "span",
                  "marks": [],
                  "text": "Your ETH goes to DefinicaCore, which forwards it to the dedicated StakeWise Vault and credits your Vault shares. The Vault funds validators, and their rewards accrue to every share."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "One deposit, put to work",
          "scene": "pooled",
          "tone": "mint"
        },
        {
          "_key": "mech02",
          "_type": "item",
          "text": [
            {
              "_key": "blkm02",
              "_type": "block",
              "children": [
                {
                  "_key": "spnm02",
                  "_type": "span",
                  "marks": [],
                  "text": "Definica's multisig can donate ETH, adding assets, or burn its own Vault shares, reducing supply. Either way, each remaining share is backed by more ETH."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "Two routes to a stronger share",
          "scene": "treasury",
          "tone": "lemonade"
        },
        {
          "_key": "mech03",
          "_type": "item",
          "text": [
            {
              "_key": "blkm03",
              "_type": "block",
              "children": [
                {
                  "_key": "spnm03",
                  "_type": "span",
                  "marks": [],
                  "text": "The Main Liquidity Module lets users supply osETH to Aave V3 Ethereum and lock the resulting aEthosETH position. With user authorisation, eligible positions can support borrowing WETH or other permitted assets to supply liquidity to Definica’s lending markets. The module tracks each participant’s commitment, allocated debt, income and withdrawal conditions."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "Committed liquidity",
          "scene": "commit",
          "tone": "baby"
        },
        {
          "_key": "mech04",
          "_type": "item",
          "text": [
            {
              "_key": "blkm04",
              "_type": "block",
              "children": [
                {
                  "_key": "spnm04",
                  "_type": "span",
                  "marks": [],
                  "text": "Borrowers pay interest on loans against approved ETH-correlated collateral. Of the lending interest attributable to you, 75% is allocated to you and 25% to Definica."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "Interest, split in the open",
          "scene": "returns",
          "tone": "sky"
        },
        {
          "_key": "mech05",
          "_type": "item",
          "text": [
            {
              "_key": "blkm05",
              "_type": "block",
              "children": [
                {
                  "_key": "spnm05",
                  "_type": "span",
                  "marks": [],
                  "text": "StakeWise Vaults give Definica what it needs: independent Vault administration, proportional accounting and adoption of approved upgrades."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "Built on StakeWise",
          "scene": "stakewise",
          "tone": "mint"
        },
        {
          "_key": "mech06",
          "_type": "item",
          "text": [
            {
              "_key": "blkm06",
              "_type": "block",
              "children": [
                {
                  "_key": "spnm06",
                  "_type": "span",
                  "marks": [],
                  "text": "Definica brings new users and their ETH to StakeWise through wallet, portfolio-app and aggregator integrations. Only net new ETH counts, not transfers between Vaults."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ],
          "title": "New stake for StakeWise",
          "scene": "growth",
          "tone": "baby"
        }
      ],
